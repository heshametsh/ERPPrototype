{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "missionId",
    "mission",
    "mode",
    "commitSha",
    "workspaceFingerprint",
    "objective",
    "requiredBehaviors",
    "decisionRefs",
    "exclusions",
    "webPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "missionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mode": {
      "type": "string",
      "enum": [
        "review",
        "product",
        "deterministic"
      ]
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "requiredBehaviors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behavior",
          "sourceDecision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RB-[0-9]{2}$"
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "sourceDecision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 30
          }
        }
      }
    },
    "decisionRefs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^DEC-[0-9]{3}$"
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "webPolicy": {
      "type": "string",
      "enum": [
        "forbidden",
        "allowed-if-needed",
        "required"
      ]
    },
    "workspaceFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
