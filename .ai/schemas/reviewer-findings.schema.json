{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentRole",
    "mission",
    "commitSha",
    "summary",
    "coverage",
    "findings",
    "confidenceTelemetry"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "agentRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspectedAreas",
        "evidenceAnchors",
        "excludedAsIrrelevant",
        "unresolved"
      ],
      "properties": {
        "inspectedAreas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "excludedAsIrrelevant": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350
          }
        },
        "evidenceAnchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^.+:[0-9]+$",
            "maxLength": 300
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "evidence",
          "impact",
          "verification",
          "challenge"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{2}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "location",
                "detail"
              ],
              "properties": {
                "location": {
                  "type": "string",
                  "pattern": "^.+:[0-9]+$"
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "challenge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "confidenceTelemetry": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Telemetry only. Hidden from Lead; never used for acceptance/ranking."
    }
  }
}
