{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agentRole", "mission", "commitSha", "summary", "findings", "confidenceTelemetry"],
  "properties": {
    "schemaVersion": {"const": 1},
    "agentRole": {"type": "string", "minLength": 1},
    "mission": {"const": "PartialAmount-AI-Team-Canary"},
    "commitSha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "evidence", "impact", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
          "claim": {"type": "string", "minLength": 1, "maxLength": 700},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["location", "detail"],
              "properties": {
                "location": {"type": "string", "pattern": "^.+:[0-9]+$"},
                "detail": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "impact": {"type": "string", "minLength": 1, "maxLength": 700},
          "verification": {"type": "string", "minLength": 1, "maxLength": 700}
        }
      }
    },
    "confidenceTelemetry": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Telemetry only. It must never be used as an acceptance gate or shown to the Lead during judgment."
    }
  }
}
