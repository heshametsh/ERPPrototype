{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentRole",
    "mission",
    "commitSha",
    "jobToBeDone",
    "projectFacts",
    "opportunities",
    "doNotBuild",
    "questions",
    "recommendedNextDiscussion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agentRole": {
      "const": "product-erp-partner"
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "jobToBeDone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    },
    "projectFacts": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "location",
                "detail"
              ],
              "properties": {
                "location": {
                  "type": "string",
                  "pattern": "^.+:[0-9]+$"
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "opportunities": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "problem",
          "proposal",
          "whyBetter",
          "employeeExample",
          "tradeoff",
          "externalPatternRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PROD-[0-9]{2}$"
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "proposal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "whyBetter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "employeeExample": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "externalPatternRefs": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "doNotBuild": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idea",
          "reason"
        ],
        "properties": {
          "idea": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "recommendedNextDiscussion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    }
  }
}
