{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mission", "commitSha", "verdict", "agreedFacts", "disagreements", "nextStep"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mission": {"const": "PartialAmount-AI-Team-Canary"},
    "commitSha": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
    "verdict": {"type": "string", "enum": ["PASS", "PASS_WITH_GAPS", "FAIL"]},
    "agreedFacts": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "sources"],
        "properties": {
          "claim": {"type": "string", "minLength": 1, "maxLength": 700},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "disagreements": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["topic", "positions", "resolution"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "positions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "nextStep": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
