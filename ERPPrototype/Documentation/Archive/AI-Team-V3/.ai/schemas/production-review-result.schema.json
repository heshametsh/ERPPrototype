    "criterionCoverage": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "acceptanceCriterion": { "type": "string" }, "classification": { "type": "string", "enum": ["COVERED", "UNRESOLVED"] }, "evidence": { "type": "string" } }, "required": ["acceptanceCriterion", "classification", "evidence"] } },
    "findings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "id": { "type": "string" }, "summary": { "type": "string" }, "impact": { "type": "string" }, "anchors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "relativePath": { "type": "string" }, "startLine": { "type": "integer" }, "endLine": { "type": "integer" } }, "required": ["relativePath", "startLine", "endLine"] } } }, "required": ["id", "summary", "impact", "anchors"] } },
