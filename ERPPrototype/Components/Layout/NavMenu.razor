@implements IDisposable

@inject NavigationManager NavigationManager

<nav class="main-navbar">
    <div class="topbar-wave" aria-hidden="true"></div>

    <div class="navbar-inner">
        <div class="brand-zone">
            <NavLink class="brand-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="brand-mark" aria-hidden="true">
                    <strong>WO</strong>
                    <small>ERP</small>
                </span>

                <span class="brand-text">
                    <strong>Work Orders</strong>
                    <small>Contractor Prototype</small>
                </span>
            </NavLink>
        </div>

        <div class="navigation-links">
            <NavLink class="navigation-link"
                     href=""
                     Match="NavLinkMatch.All">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M3 11.5 12 4l9 7.5" />
                    <path d="M5.5 10v9h13v-9" />
                    <path d="M9.5 19v-5h5v5" />
                </svg>
                <span>الرئيسية</span>
            </NavLink>

            <AuthorizeView Roles="Employee">
                <Authorized>
                    <NavLink class="navigation-link"
                             href="work-orders">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <rect x="5" y="3.5" width="14" height="17" rx="2" />
                            <path d="M8.5 8h7M8.5 12h7M8.5 16h4" />
                        </svg>
                        <span>أوامر العمل</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink class="navigation-link"
                             href="admin">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <path d="M4 5.5h16v13H4z" />
                            <path d="M8 9h8M8 13h5" />
                        </svg>
                        <span>لوحة الإدارة</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="navbar-right">
            <AuthorizeView>
                <Authorized Context="authContext">
                    <NavLink class="user-card"
                             href="Account/Manage/ChangePassword"
                             title="@authContext.User.Identity?.Name">
                        <span class="user-avatar">
                            @GetUserInitial(authContext.User.Identity?.Name)
                        </span>

                        <span class="user-details">
                            <small>الحساب الحالي</small>
                            <strong>
                                @GetDisplayUserName(authContext.User.Identity?.Name)
                            </strong>
                        </span>
                    </NavLink>

                    <form action="Account/Logout"
                          method="post"
                          class="logout-form">
                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="@currentUrl" />

                        <button type="submit"
                                class="logout-button">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M10 5H5v14h5" />
                                <path d="M13 8l4 4-4 4M8 12h9" />
                            </svg>
                            <span>تسجيل الخروج</span>
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="login-link"
                             href="Account/Login">
                        تسجيل الدخول
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private static string GetUserInitial(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return "U";
        }

        return userName.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string GetDisplayUserName(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return "User";
        }

        var value = userName.Trim();
        var atIndex = value.IndexOf('@');

        if (atIndex > 0)
        {
            value = value[..atIndex];
        }

        return value.Length > 18
            ? $"{value[..18]}..."
            : value;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
