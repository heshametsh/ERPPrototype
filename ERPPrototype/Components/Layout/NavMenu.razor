@implements IDisposable

@inject NavigationManager NavigationManager

<nav class="main-navbar">
    <div class="navbar-inner">

        <div class="navbar-left">

            <NavLink class="brand-link"
                     href=""
                     Match="NavLinkMatch.All">

                <span class="brand-mark">WO</span>

                <span class="brand-text">
                    <strong>Work Orders</strong>
                    <small>Contractor Prototype</small>
                </span>

            </NavLink>

            <div class="navigation-links">

                <NavLink class="navigation-link"
                         href=""
                         Match="NavLinkMatch.All">
                    الرئيسية
                </NavLink>

                <AuthorizeView Roles="Employee">
                    <Authorized>
                        <NavLink class="navigation-link"
                                 href="work-orders">
                            أوامر العمل
                        </NavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <NavLink class="navigation-link"
                                 href="admin">
                            لوحة الإدارة
                        </NavLink>
                    </Authorized>
                </AuthorizeView>

            </div>

        </div>

        <input id="navigation-toggle"
               type="checkbox"
               class="navigation-toggle"
               title="فتح أو إغلاق القائمة" />

        <label for="navigation-toggle"
               class="navigation-toggle-button"
               aria-label="فتح القائمة">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <div class="navbar-right">

            <AuthorizeView>
                <Authorized Context="authContext">

                    <NavLink class="user-card"
                             href="Account/Manage/ChangePassword"
                             title="@authContext.User.Identity?.Name">

                        <span class="user-avatar">
                            @GetUserInitial(authContext.User.Identity?.Name)
                        </span>

                        <span class="user-details">
                            <small>الحساب الحالي</small>

                            <strong>
                                @GetDisplayUserName(
                                    authContext.User.Identity?.Name)
                            </strong>
                        </span>

                    </NavLink>

                    <form action="Account/Logout"
                          method="post"
                          class="logout-form">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="@currentUrl" />

                        <button type="submit"
                                class="logout-button">
                            تسجيل الخروج
                        </button>

                    </form>

                </Authorized>

                <NotAuthorized>

                    <NavLink class="login-link"
                             href="Account/Login">
                        تسجيل الدخول
                    </NavLink>

                </NotAuthorized>
            </AuthorizeView>

        </div>

    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl =
            NavigationManager.ToBaseRelativePath(
                NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        currentUrl =
            NavigationManager.ToBaseRelativePath(e.Location);

        StateHasChanged();
    }

    private static string GetUserInitial(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return "U";
        }

        return userName.Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }

    private static string GetDisplayUserName(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return "User";
        }

        var value = userName.Trim();
        var atIndex = value.IndexOf('@');

        if (atIndex > 0)
        {
            value = value[..atIndex];
        }

        return value.Length > 18
            ? $"{value[..18]}..."
            : value;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}