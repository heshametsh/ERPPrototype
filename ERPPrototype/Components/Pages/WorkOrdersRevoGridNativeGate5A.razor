@page "/work-orders-revogrid-gate5a"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable

@using ERPPrototype.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = AppRoles.Employee)]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject WorkOrderService WorkOrderService
@inject IJSRuntime JSRuntime
@inject ILogger<WorkOrdersRevoGridNativeGate5A> Logger

<PageTitle>@(EnableHeaderMultiSelection ? "RevoGrid Gate 5B-10" : EnableStructureWorkspace ? "RevoGrid Gate 5B-9" : EnableSelectionContext ? "RevoGrid Gate 5B-8" : EnablePersistenceIdentity ? "RevoGrid Gate 5B-7" : EnableUnifiedValidation ? "RevoGrid Gate 5B-6" : EnableRowStructure ? "RevoGrid Gate 5B-5" : EnableHeaderActions ? "RevoGrid Gate 5B-4" : EnableExcelFilter ? "RevoGrid Gate 5B-3" : EnablePaste ? "RevoGrid Gate 5B-2" : EnableChangeEngine ? "RevoGrid Gate 5B-1" : "RevoGrid Native Gate 5A")</PageTitle>

<div class="native-gate5a" data-testid="revogrid-native-gate5a">
    <header class="native-gate5a__header">
        <div class="native-gate5a__identity">
            <strong>RevoGrid Community 4.25.2</strong>
            <span>@(EnableHeaderMultiSelection
                ? "Gate 5B-10 — Ctrl/Shift whole-row/whole-column selection over the stable Gate 5B-9 behavior"
                : EnableStructureWorkspace
                ? "Gate 5B-9 — Shared Rows/Columns Structure Workspace over the stable Gate 5B-8 behavior"
                : EnableSelectionContext
                ? "Gate 5B-8 — Shared Selection Context over the stable Gate 5B-7 behavior"
                : EnablePersistenceIdentity
                ? "Gate 5B-7 — Persistence Identity over the stable Gate 5B-6 behavior"
                : EnableUnifiedValidation
                ? "Gate 5B-6 — Unified Validation over the stable Gate 5B-5 behavior"
                : EnableRowStructure
                ? "Gate 5B-5 — Insert/Delete Rows → Change Engine + Sheet History"
                : EnableHeaderActions
                ? "Gate 5B-4 — Excel-like Filter + dedicated Sort + visible-column selection → Sheet History"
                : EnableExcelFilter
                    ? "Gate 5B-3 — Excel-like Filter → Revo native Filter Engine → Sheet History"
                : EnablePaste
                    ? "Gate 5B-2 — Cell Edit + Paste → Sheet History / real data"
                    : EnableChangeEngine
                        ? "Gate 5B-1 — Cell Edit → Change Engine / real data"
                        : "Gate 5A — clean native baseline / real data")</span>
        </div>

        <div class="native-gate5a__scope">
            <div>
                <span>الفرع</span>
                <strong>@DisplayOrDash(BranchName)</strong>
            </div>

            <div>
                <span>القسم</span>
                <strong>@DisplayOrDash(DepartmentName)</strong>
            </div>

            <label>
                <span>السنة</span>
                <select @onchange="HandleYearChangedAsync"
                        disabled="@(IsLoading || IsYearLoading)"
                        data-testid="gate5a-year-selector">
                    @foreach (var year in AvailableWorkYears)
                    {
                        <option value="@year"
                                selected="@(year == SelectedWorkYear)">
                            @year
                        </option>
                    }
                </select>
            </label>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="native-gate5a__error" role="alert">@ErrorMessage</div>
    }
    else
    {
        <div class="native-gate5a__statusbar">
            <span><b id="@RowCountElementId">@Rows.Count.ToString("N0")</b> صف</span>
            <span>Server <b>@FormatMilliseconds(ServerLoadMilliseconds)</b></span>

            @if (Diagnostics is not null)
            {
                <span>Grid <b>@FormatMilliseconds(Diagnostics.ReadyMs)</b></span>
                <span>Heap <b>@FormatMegabytes(Diagnostics.HeapMb)</b></span>
                <span>Scroll <b>@Diagnostics.ScrollEvents</b></span>
                <span>Selection <b>@Diagnostics.Selection</b></span>
                <span>Dataset <b>@Diagnostics.WorkYear</b></span>
                <span>Dataset switches <b>@Diagnostics.DatasetSwitches</b></span>
            }

            @if (!string.IsNullOrWhiteSpace(OperationMessage))
            {
                <span class="native-gate5a__operation-message">@OperationMessage</span>
            }

            @if (EnableChangeEngine)
            {
                <span class="native-gate5a__change-engine-state">
                    Change Engine <b id="@ChangeStatusElementId">Clean</b>
                </span>
                <span>Undo <b id="@UndoCountElementId">0</b></span>
                <span>Redo <b id="@RedoCountElementId">0</b></span>
                <span id="@FinancialErrorElementId" class="native-gate5a__financial-errors"></span>
                <span class="native-gate5a__change-engine-controls">
                    <button id="@UndoButtonId" type="button" disabled>Undo</button>
                    <button id="@RedoButtonId" type="button" disabled>Redo</button>
                </span>
            }

            <button type="button"
                    @onclick="RefreshDiagnosticsAsync"
                    disabled="@(!GridInitialized || IsYearLoading)">
                تحديث القياس
            </button>
        </div>

        <main class="native-gate5a__grid-shell">
            @if (IsLoading || IsYearLoading)
            {
                <div class="native-gate5a__loading">
                    @(IsYearLoading ? "جاري تحميل السنة المطلوبة…" : "جاري تحميل Work Orders الحقيقية…")
                </div>
            }

            <div id="@GridElementId"
                 class="native-gate5a__grid-host">
            </div>
        </main>

        <footer class="native-gate5a__note">
            @if (EnableHeaderMultiSelection)
            {
                <span>Gate 5B-10 يضيف Ctrl/Shift لتحديد الصفوف والأعمدة بالهوية فوق Revo Community، مع بقاء Revo مسؤولًا عن Cell Focus/Range/Keyboard/Editing/Virtualization. Filter يزيل الصف المخفي من التحديد ولا يعيده تلقائيًا، بينما Sort/Scroll يحافظان على نفس Work Orders. لا يوجد Save لقاعدة البيانات بعد.</span>
            }
            else if (EnableStructureWorkspace)
            {
                <span>Gate 5B-9 ينقل قائمة الكليك اليمين إلى Structure Menu واحدة للصفوف والأعمدة. Insert يحدد العدد والاتجاه داخل Dialog، والحذف يعمل على Rows/Custom Columns الموجودة في Selection فقط. إضافة/حذف Custom Columns يدخلان نفس Sheet History. Paste-to-fill يستخدم Revo Community rangeFill. لا يوجد Save لقاعدة البيانات بعد.</span>
            }
            else if (EnableSelectionContext)
            {
                <span>Gate 5B-8 يحافظ على سلوك Gate 5B-7 كما هو، ويضيف فهمًا موحدًا لمعنى التحديد. الكليك اليمين داخل عمود محدد بالكامل لا يحوله إلى خلية واحدة، وتحديد العمود لا يُفسر كأنه تحديد لكل صفوف الشيت.</span>
            }
            else if (EnablePersistenceIdentity)
            {
                <span>Gate 5B-7 يحافظ على سلوك Gate 5B-6 كما هو، ويضيف تتبع هوية الصف المحفوظة حتى لو اختفى الصف من الشاشة. الحذف يظل مؤقتًا حتى Save لاحق، وUndo/Redo لا يفقدان هوية أمر العمل. لا يوجد Save لقاعدة البيانات بعد.</span>
            }
            else if (EnableUnifiedValidation)
            {
                <span>Gate 5B-6 يحافظ على سلوك Gate 5B-5 كما هو، ويضيف Validation موحدة بعد Manual Edit / Paste / Range Clear / Undo / Redo وتغييرات الصفوف. القيمة غير الصحيحة تظل ظاهرة ومعلّمة، وSave سيظل ممنوعًا لاحقًا حتى تختفي الأخطاء. لا يوجد Save لقاعدة البيانات بعد.</span>
            }
            else if (EnableRowStructure)
            {
                <span>Gate 5B-5 يضيف Insert/Delete من قائمة الكليك اليمين وDelete/Backspace لمسح نطاق الخلايا القابلة للتعديل. Range Clear يدخل Dirty وSheet History كعملية Undo واحدة، وRemaining Amount يعاد حسابه من القيم المالية. لا يوجد Save لقاعدة البيانات بعد.</span>
            }
            else if (EnableHeaderActions)
            {
                <span>Gate 5B-4 يفصل تفاعل رأس العمود: الضغط على اسم الهيدر يحدد العمود للصفوف الظاهرة فقط، زر الفلتر يفتح Excel-like Filter، وزر الـSort المخصص يستدعي Revo SortingPlugin من الـAPI الرسمي. Filter/Sort لا يدخلان Dirty وكلاهما يدخل Sheet History.</span>
            }
            else if (EnableExcelFilter)
            {
                <span>Gate 5B-3 يضيف واجهة فلتر شبيهة Excel فوق Revo Community FilterPlugin: Work Order Number / Work Type / Assignment Date / Basket وCustom Text-Date-Number فقط. الفلتر لا يدخل Dirty، لكنه يدخل Sheet History كحركة واحدة عند Apply أو Clear. أعمدة المبالغ تظل Sort فقط.</span>
            }
            else if (EnablePaste)
            {
                <span>Gate 5B-2 يربط Cell Edit وPaste بنفس Sheet History وChange Engine. الـPaste مهما كان حجمه يسجل كعملية Undo واحدة، ولا يوجد Save لقاعدة البيانات في هذه المرحلة.</span>
            }
            else if (EnableChangeEngine)
            {
                <span>Gate 5B-1 يربط تعديل الخلية فقط بالمحرك. Undo/Redo يعملان من نفس History، والـPaste يظل مقفولًا في هذا المسار المرجعي.</span>
            }
            else
            {
                <span>السنة الحالية هي نقطة البداية في كل فتح جديد. اختيار السنة يستخدم الطريقة التي نجحت في الاختبار المعزول، ثم يبدّل RevoGrid Dataset مرة واحدة. أي تعديل داخل Gate 5A مؤقت ولا يُحفظ في قاعدة البيانات.</span>
            }
        </footer>
    }
</div>
