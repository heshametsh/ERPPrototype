@page "/grid-test"
@rendermode InteractiveServer

<PageTitle>Grid Test</PageTitle>

<h1>اختبار Syncfusion DataGrid</h1>

<SfGrid DataSource="@WorkOrders"
        AllowPaging="true"
        AllowSorting="true"
        AllowFiltering="true">

    <GridPageSettings PageSize="5"></GridPageSettings>

    <GridColumns>
        <GridColumn Field="@nameof(TestWorkOrder.WorkOrderNumber)"
                    HeaderText="رقم أمر العمل"
                    Width="180">
        </GridColumn>

        <GridColumn Field="@nameof(TestWorkOrder.WorkType)"
                    HeaderText="النوع"
                    Width="120">
        </GridColumn>

        <GridColumn Field="@nameof(TestWorkOrder.Status)"
                    HeaderText="الحالة"
                    Width="180">
        </GridColumn>

        <GridColumn Field="@nameof(TestWorkOrder.AssignmentDate)"
                    HeaderText="تاريخ الإسناد"
                    Type="ColumnType.Date"
                    Format="dd/MM/yyyy"
                    Width="150">
        </GridColumn>
    </GridColumns>

</SfGrid>

