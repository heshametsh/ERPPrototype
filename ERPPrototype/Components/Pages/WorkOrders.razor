@page "/work-orders"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using ERPPrototype.Data
@using ERPPrototype.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids

@attribute [Authorize(Roles = AppRoles.Employee)]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ILogger<WorkOrders> Logger

<PageTitle>Work Orders</PageTitle>

<div class="container-fluid work-orders-page" dir="ltr">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h1 class="mb-1">Work Orders</h1>

            @if (!string.IsNullOrWhiteSpace(DepartmentName))
            {
                <div class="text-muted">
                    @BranchName — @DepartmentName
                </div>
            }
        </div>

        <div class="text-end">
            <button type="button"
                    class="btn btn-primary px-4"
                    disabled="@IsSaving"
                    @onclick="SaveNowAsync">
                @(IsSaving ? "Saving..." : "Save")
            </button>

            <div class="small mt-2 @SaveStateCssClass">
                @SaveStateMessage
            </div>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="alert alert-info">
            Loading work orders...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadingErrorMessage))
    {
        <div class="alert alert-danger">
            @LoadingErrorMessage
        </div>
    }
    else
    {
        <div class="alert alert-secondary py-2">
            Click any editable cell once and start typing.
            Use <strong>Tab</strong> to move to the next cell.
            Complete changes are saved automatically after 30 seconds
            and checked every 3 minutes.
        </div>

        @if (!string.IsNullOrWhiteSpace(OperationErrorMessage))
        {
            <div class="alert alert-danger">
                @OperationErrorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="alert alert-success">
                @SuccessMessage
            </div>
        }

        <SfGrid @ref="WorkOrdersGrid"
                ID="EmployeeWorkOrdersGrid"
                TValue="WorkOrder"
                DataSource="@WorkOrderItems"
                Toolbar="@ToolbarItems"
                AllowSorting="true"
                AllowFiltering="true"
                AllowResizing="true"
                AllowReordering="true"
                AllowSelection="true"
                ShowColumnChooser="true"
                EnableAutoFill="true"
                Height="600">

            <GridEvents TValue="WorkOrder"
                        CellSaved="CellSavedAsync"
                        OnBatchSave="SaveBatchAsync" />

            <GridEditSettings AllowAdding="true"
                              AllowEditing="true"
                              AllowDeleting="true"
                              Mode="EditMode.Batch"
                              AllowEditOnSingleClick="true"
                              AllowNextRowEdit="true"
                              NewRowPosition="NewRowPosition.Bottom"
                              ShowConfirmDialog="false"
                              ShowDeleteConfirmDialog="true" />

            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />

            <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Both"
                                   Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"
                                   CellSelectionMode="Syncfusion.Blazor.Grids.CellSelectionMode.Box" />

            <GridColumns>
                <GridColumn Field="@nameof(WorkOrder.Id)"
                            IsPrimaryKey="true"
                            Visible="false"
                            AllowEditing="false"
                            AllowAdding="false" />

                <GridColumn Field="@nameof(WorkOrder.WorkOrderNumber)"
                            HeaderText="Work Order Number"
                            Width="190" />

                <GridColumn Field="@nameof(WorkOrder.WorkTypeCode)"
                            HeaderText="Work Type"
                            Width="130" />

                <GridColumn Field="@nameof(WorkOrder.AssignmentDate)"
                            HeaderText="Assignment Date"
                            EditType="EditType.DatePickerEdit"
                            Format="dd/MM/yyyy"
                            Type="ColumnType.Date"
                            Width="170" />

                <GridColumn Field="@nameof(WorkOrder.Busket)"
                            HeaderText="Busket"
                            Width="280">
                    <EditTemplate Context="busketContext">
                        @{
                            var workOrder = (WorkOrder)busketContext;
                        }

                        <SfDropDownList TValue="string"
                                        TItem="string"
                                        DataSource="@WorkOrderBuskets.All"
                                        @bind-Value="workOrder.Busket"
                                        AllowFiltering="true"
                                        ShowClearButton="false"
                                        PopupHeight="320px">
                        </SfDropDownList>
                    </EditTemplate>
                </GridColumn>

                <GridColumn Field="@nameof(WorkOrder.Status)"
                            HeaderText="Status"
                            Width="170" />

                <GridColumn Field="@nameof(WorkOrder.Notes)"
                            HeaderText="Notes"
                            Width="320" />
            </GridColumns>
        </SfGrid>
    }
</div>

@code {
    private const int BlankRowsTarget = 7;
    private static readonly TimeSpan IdleSaveDelay = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan PeriodicSaveInterval = TimeSpan.FromMinutes(3);

    private SfGrid<WorkOrder>? WorkOrdersGrid;

    private List<WorkOrder> WorkOrderItems { get; set; } = [];

    private readonly List<string> ToolbarItems =
    [
        "Delete",
        "Cancel",
        "Search",
        "ColumnChooser"
    ];

    private string BranchName { get; set; } = string.Empty;
    private string DepartmentName { get; set; } = string.Empty;
    private string CurrentUserId { get; set; } = string.Empty;
    private int CurrentDepartmentId { get; set; }

    private string LoadingErrorMessage { get; set; } = string.Empty;
    private string OperationErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;

    private string SaveStateMessage { get; set; } = "All changes saved";
    private string SaveStateCssClass { get; set; } = "text-success";

    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private bool HasUnsavedChanges { get; set; }

    private int NextTemporaryId { get; set; } = -1;

    private CancellationTokenSource? ComponentCancellation;
    private CancellationTokenSource? IdleSaveCancellation;
    private Task? PeriodicSaveTask;

    protected override async Task OnInitializedAsync()
    {
        ComponentCancellation = new CancellationTokenSource();

        await LoadEmployeeSheetAsync();

        if (string.IsNullOrWhiteSpace(LoadingErrorMessage))
        {
            PeriodicSaveTask = RunPeriodicSaveLoopAsync(
                ComponentCancellation.Token);
        }
    }

    private async Task LoadEmployeeSheetAsync()
    {
        IsLoading = true;
        LoadingErrorMessage = string.Empty;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var currentUser =
                await UserManager.GetUserAsync(authenticationState.User);

            if (currentUser is null)
            {
                LoadingErrorMessage =
                    "The current user could not be identified.";
                return;
            }

            if (currentUser.DepartmentId is null)
            {
                LoadingErrorMessage =
                    "This employee is not assigned to a department.";
                return;
            }

            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            var department = await dbContext.Departments
                .AsNoTracking()
                .Include(item => item.Branch)
                .Include(item => item.DepartmentType)
                .SingleOrDefaultAsync(item =>
                    item.Id == currentUser.DepartmentId.Value);

            if (department is null)
            {
                LoadingErrorMessage =
                    "The employee department could not be found.";
                return;
            }

            CurrentUserId = currentUser.Id;
            CurrentDepartmentId = department.Id;

            BranchName = department.Branch.Name;
            DepartmentName = department.DepartmentType.Name;

            WorkOrderItems = await dbContext.WorkOrders
                .AsNoTracking()
                .Where(workOrder =>
                    workOrder.DepartmentId == CurrentDepartmentId)
                .OrderBy(workOrder =>
                    workOrder.Id)
                .ToListAsync();

            AddBlankRows(BlankRowsTarget);
            SetSavedState();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An error occurred while loading employee work orders.");

            LoadingErrorMessage =
                "An unexpected error occurred while loading the sheet.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private WorkOrder CreateBlankRow()
    {
        return new WorkOrder
        {
            Id = NextTemporaryId--,
            DepartmentId = CurrentDepartmentId,
            WorkYear = DateTime.Now.Year,
            Busket = string.Empty,
            Status = string.Empty,
            CreatedAt = DateTime.UtcNow,
            CreatedBy = CurrentUserId
        };
    }

    private void AddBlankRows(int count)
    {
        for (var index = 0; index < count; index++)
        {
            WorkOrderItems.Add(CreateBlankRow());
        }
    }

    private async Task CellSavedAsync(
        CellSavedArgs<WorkOrder> args)
    {
        OperationErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        HasUnsavedChanges = true;
        SaveStateMessage = "Unsaved changes";
        SaveStateCssClass = "text-warning";

        ScheduleIdleSave();

        var blankCount =
            WorkOrderItems.Count(IsCompletelyBlank);

        if (blankCount <= 2 && WorkOrdersGrid is not null)
        {
            var rowsToAdd = BlankRowsTarget - blankCount;

            for (var index = 0; index < rowsToAdd; index++)
            {
                await WorkOrdersGrid.AddRecordAsync(
                    CreateBlankRow(),
                    WorkOrderItems.Count + index);
            }
        }
    }

    private void ScheduleIdleSave()
    {
        IdleSaveCancellation?.Cancel();
        IdleSaveCancellation?.Dispose();

        IdleSaveCancellation =
            CancellationTokenSource.CreateLinkedTokenSource(
                ComponentCancellation?.Token ??
                CancellationToken.None);

        _ = SaveAfterIdleDelayAsync(
            IdleSaveCancellation.Token);
    }

    private async Task SaveAfterIdleDelayAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(
                IdleSaveDelay,
                cancellationToken);

            await InvokeAsync(SaveNowAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RunPeriodicSaveLoopAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            using var timer =
                new PeriodicTimer(PeriodicSaveInterval);

            while (await timer.WaitForNextTickAsync(
                       cancellationToken))
            {
                await InvokeAsync(SaveNowAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveNowAsync()
    {
        if (!HasUnsavedChanges ||
            IsSaving ||
            WorkOrdersGrid is null)
        {
            return;
        }

        IsSaving = true;
        OperationErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        SaveStateMessage = "Saving...";
        SaveStateCssClass = "text-primary";

        try
        {
            await WorkOrdersGrid.EndEditAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An error occurred while requesting a grid save.");

            HasUnsavedChanges = true;
            OperationErrorMessage =
                "An unexpected error occurred while saving.";

            SaveStateMessage = "Save failed";
            SaveStateCssClass = "text-danger";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SaveBatchAsync(
        BeforeBatchSaveArgs<WorkOrder> args)
    {
        OperationErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        if (args.BatchChanges is null)
        {
            return;
        }

        var addedRecords =
            args.BatchChanges.AddedRecords ?? [];

        var changedRecords =
            args.BatchChanges.ChangedRecords ?? [];

        var deletedRecords =
            args.BatchChanges.DeletedRecords ?? [];

        var newRecords = addedRecords
            .Concat(
                changedRecords.Where(
                    workOrder => workOrder.Id <= 0))
            .Where(workOrder =>
                !IsCompletelyBlank(workOrder))
            .GroupBy(workOrder => workOrder.Id)
            .Select(group => group.Last())
            .ToList();

        var existingChangedRecords = changedRecords
            .Where(workOrder => workOrder.Id > 0)
            .ToList();

        var existingDeletedRecords = deletedRecords
            .Where(workOrder => workOrder.Id > 0)
            .ToList();

        foreach (var workOrder in newRecords)
        {
            NormalizeEditableFields(workOrder);
        }

        foreach (var workOrder in existingChangedRecords)
        {
            NormalizeEditableFields(workOrder);
        }

        var validationError = ValidateRecords(
            newRecords.Concat(existingChangedRecords));

        if (!string.IsNullOrWhiteSpace(validationError))
        {
            args.Cancel = true;
            HasUnsavedChanges = true;

            OperationErrorMessage = validationError;
            SaveStateMessage = "Required fields are incomplete";
            SaveStateCssClass = "text-danger";
            return;
        }

        try
        {
            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            await using var transaction =
                await dbContext.Database.BeginTransactionAsync();

            var deletedIds = existingDeletedRecords
                .Select(workOrder => workOrder.Id)
                .Distinct()
                .ToHashSet();

            var databaseRows = await dbContext.WorkOrders
                .AsNoTracking()
                .Where(workOrder =>
                    workOrder.DepartmentId == CurrentDepartmentId)
                .Select(workOrder => new WorkOrderKeySnapshot
                {
                    Id = workOrder.Id,
                    WorkOrderNumber = workOrder.WorkOrderNumber,
                    WorkTypeCode = workOrder.WorkTypeCode
                })
                .ToListAsync();

            var finalRows = databaseRows
                .Where(workOrder =>
                    !deletedIds.Contains(workOrder.Id))
                .ToList();

            foreach (var changedRecord in existingChangedRecords)
            {
                var existingSnapshot = finalRows
                    .SingleOrDefault(workOrder =>
                        workOrder.Id == changedRecord.Id);

                if (existingSnapshot is null)
                {
                    args.Cancel = true;
                    HasUnsavedChanges = true;

                    OperationErrorMessage =
                        "A modified work order could not be found in this department.";

                    SaveStateMessage = "Save failed";
                    SaveStateCssClass = "text-danger";
                    return;
                }

                existingSnapshot.WorkOrderNumber =
                    changedRecord.WorkOrderNumber;

                existingSnapshot.WorkTypeCode =
                    changedRecord.WorkTypeCode;
            }

            var temporarySnapshotId = -1;

            foreach (var newRecord in newRecords)
            {
                finalRows.Add(new WorkOrderKeySnapshot
                {
                    Id = temporarySnapshotId--,
                    WorkOrderNumber =
                        newRecord.WorkOrderNumber,
                    WorkTypeCode =
                        newRecord.WorkTypeCode
                });
            }

            var duplicateGroup = finalRows
                .GroupBy(workOrder =>
                    CreateDuplicateKey(
                        workOrder.WorkOrderNumber,
                        workOrder.WorkTypeCode))
                .FirstOrDefault(group =>
                    group.Count() > 1);

            if (duplicateGroup is not null)
            {
                args.Cancel = true;
                HasUnsavedChanges = true;

                var duplicate =
                    duplicateGroup.First();

                OperationErrorMessage =
                    $"Work Order Number '{duplicate.WorkOrderNumber}' " +
                    $"with Work Type '{duplicate.WorkTypeCode}' " +
                    "already exists in this department.";

                SaveStateMessage = "Duplicate work order";
                SaveStateCssClass = "text-danger";
                return;
            }

            if (deletedIds.Count > 0)
            {
                var entitiesToDelete =
                    await dbContext.WorkOrders
                        .Where(workOrder =>
                            workOrder.DepartmentId ==
                                CurrentDepartmentId &&
                            deletedIds.Contains(workOrder.Id))
                        .ToListAsync();

                if (entitiesToDelete.Count != deletedIds.Count)
                {
                    args.Cancel = true;
                    HasUnsavedChanges = true;

                    OperationErrorMessage =
                        "One or more selected work orders do not belong to this department.";

                    SaveStateMessage = "Save failed";
                    SaveStateCssClass = "text-danger";
                    return;
                }

                dbContext.WorkOrders.RemoveRange(
                    entitiesToDelete);
            }

            var changedIds = existingChangedRecords
                .Select(workOrder => workOrder.Id)
                .Distinct()
                .ToHashSet();

            if (changedIds.Count > 0)
            {
                var entitiesToUpdate =
                    await dbContext.WorkOrders
                        .Where(workOrder =>
                            workOrder.DepartmentId ==
                                CurrentDepartmentId &&
                            changedIds.Contains(workOrder.Id))
                        .ToListAsync();

                if (entitiesToUpdate.Count != changedIds.Count)
                {
                    args.Cancel = true;
                    HasUnsavedChanges = true;

                    OperationErrorMessage =
                        "One or more modified work orders do not belong to this department.";

                    SaveStateMessage = "Save failed";
                    SaveStateCssClass = "text-danger";
                    return;
                }

                var changedById =
                    existingChangedRecords.ToDictionary(
                        workOrder => workOrder.Id);

                foreach (var entity in entitiesToUpdate)
                {
                    var changedRecord =
                        changedById[entity.Id];

                    entity.WorkOrderNumber =
                        changedRecord.WorkOrderNumber;

                    entity.WorkTypeCode =
                        changedRecord.WorkTypeCode;

                    entity.AssignmentDate =
                        changedRecord.AssignmentDate;

                    entity.Busket =
                        changedRecord.Busket;

                    entity.Status =
                        changedRecord.Status;

                    entity.Notes =
                        changedRecord.Notes;

                    entity.UpdatedAt =
                        DateTime.UtcNow;

                    entity.UpdatedBy =
                        CurrentUserId;
                }
            }

            foreach (var newRecord in newRecords)
            {
                newRecord.Id = 0;
                newRecord.DepartmentId =
                    CurrentDepartmentId;
                newRecord.WorkYear =
                    DateTime.Now.Year;
                newRecord.CreatedAt =
                    DateTime.UtcNow;
                newRecord.CreatedBy =
                    CurrentUserId;
                newRecord.UpdatedAt = null;
                newRecord.UpdatedBy = null;

                dbContext.WorkOrders.Add(newRecord);
            }

            await dbContext.SaveChangesAsync();
            await transaction.CommitAsync();

            IdleSaveCancellation?.Cancel();

            HasUnsavedChanges = false;
            SuccessMessage =
                "All changes were saved successfully.";

            SetSavedState();
        }
        catch (DbUpdateException exception)
        {
            args.Cancel = true;
            HasUnsavedChanges = true;

            Logger.LogError(
                exception,
                "A database error occurred while saving work orders.");

            OperationErrorMessage =
                "The changes could not be saved. Check for duplicate or invalid values.";

            SaveStateMessage = "Save failed";
            SaveStateCssClass = "text-danger";
        }
        catch (Exception exception)
        {
            args.Cancel = true;
            HasUnsavedChanges = true;

            Logger.LogError(
                exception,
                "An unexpected error occurred while saving work orders.");

            OperationErrorMessage =
                "An unexpected error occurred while saving the changes.";

            SaveStateMessage = "Save failed";
            SaveStateCssClass = "text-danger";
        }
    }

    private static bool IsCompletelyBlank(
        WorkOrder workOrder)
    {
        return
            string.IsNullOrWhiteSpace(
                workOrder.WorkOrderNumber) &&
            string.IsNullOrWhiteSpace(
                workOrder.WorkTypeCode) &&
            workOrder.AssignmentDate is null &&
            string.IsNullOrWhiteSpace(
                workOrder.Busket) &&
            string.IsNullOrWhiteSpace(
                workOrder.Status) &&
            string.IsNullOrWhiteSpace(
                workOrder.Notes);
    }

    private static void NormalizeEditableFields(
        WorkOrder workOrder)
    {
        workOrder.WorkOrderNumber =
            workOrder.WorkOrderNumber?.Trim()
            ?? string.Empty;

        workOrder.WorkTypeCode =
            workOrder.WorkTypeCode?.Trim()
            ?? string.Empty;

        workOrder.Busket =
            workOrder.Busket?.Trim()
            ?? string.Empty;

        workOrder.Status =
            workOrder.Status?.Trim()
            ?? string.Empty;

        workOrder.Notes =
            string.IsNullOrWhiteSpace(workOrder.Notes)
                ? null
                : workOrder.Notes.Trim();
    }

    private static string? ValidateRecords(
        IEnumerable<WorkOrder> workOrders)
    {
        foreach (var workOrder in workOrders)
        {
            if (string.IsNullOrWhiteSpace(
                    workOrder.WorkOrderNumber))
            {
                return "Work Order Number is required.";
            }

            if (workOrder.WorkOrderNumber.Length > 50)
            {
                return
                    "Work Order Number cannot exceed 50 characters.";
            }

            if (string.IsNullOrWhiteSpace(
                    workOrder.WorkTypeCode))
            {
                return "Work Type is required.";
            }

            if (workOrder.WorkTypeCode.Length > 20)
            {
                return
                    "Work Type cannot exceed 20 characters.";
            }

            if (string.IsNullOrWhiteSpace(
                    workOrder.Busket))
            {
                return "Busket is required.";
            }

            if (!WorkOrderBuskets.All.Contains(
                    workOrder.Busket))
            {
                return
                    "Select a valid value from the Busket list.";
            }

            if (workOrder.Status?.Length > 150)
            {
                return
                    "Status cannot exceed 150 characters.";
            }

            if (workOrder.Notes?.Length > 1000)
            {
                return
                    "Notes cannot exceed 1000 characters.";
            }
        }

        return null;
    }

    private static string CreateDuplicateKey(
        string workOrderNumber,
        string workTypeCode)
    {
        return string.Concat(
            workOrderNumber.Trim().ToUpperInvariant(),
            "\u001F",
            workTypeCode.Trim().ToUpperInvariant());
    }

    private void SetSavedState()
    {
        SaveStateMessage = "All changes saved";
        SaveStateCssClass = "text-success";
    }

    public async ValueTask DisposeAsync()
    {
        IdleSaveCancellation?.Cancel();
        IdleSaveCancellation?.Dispose();

        ComponentCancellation?.Cancel();

        if (PeriodicSaveTask is not null)
        {
            try
            {
                await PeriodicSaveTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        ComponentCancellation?.Dispose();
    }

    private sealed class WorkOrderKeySnapshot
    {
        public int Id { get; set; }

        public string WorkOrderNumber { get; set; } =
            string.Empty;

        public string WorkTypeCode { get; set; } =
            string.Empty;
    }
}
