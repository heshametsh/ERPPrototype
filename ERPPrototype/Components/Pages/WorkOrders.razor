@page "/work-orders"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable

@using System.Diagnostics
@using System.Globalization
@using System.Text.Json
@using ERPPrototype.Data
@using ERPPrototype.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = AppRoles.Employee)]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject WorkOrderService WorkOrderService
@inject IJSRuntime JSRuntime
@inject ILogger<WorkOrders> Logger

<PageTitle>Work Orders</PageTitle>

<div class="work-orders-page tabulator-workorders-page"
     data-testid="work-orders-page">

    <div class="work-orders-sticky-controls">
        <div class="page-heading-row">
            <div class="title-area">
                <div class="scope-identity"
                     data-testid="work-orders-scope"
                     aria-label="الفرع والقسم">
                    @if (IsLoading)
                    {
                        <div class="scope-identity-item scope-branch">
                            <span class="scope-identity-label">الفرع</span>
                            <strong>جاري التحميل...</strong>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(DepartmentName))
                    {
                        <div class="scope-identity-item scope-branch">
                            <span class="scope-identity-label">الفرع</span>
                            <strong title="@BranchName">@BranchDisplayName</strong>
                        </div>

                        <span class="scope-identity-divider" aria-hidden="true"></span>

                        <div class="scope-identity-item scope-department">
                            <span class="scope-identity-label">القسم</span>
                            <strong title="@DepartmentName">@DepartmentDisplayName</strong>
                        </div>
                    }
                    else
                    {
                        <div class="scope-identity-item scope-branch">
                            <span class="scope-identity-label">الفرع</span>
                            <strong>Work Orders</strong>
                        </div>
                    }
                </div>

                @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <label class="year-control year-control-prominent">
                        <span>السنة</span>

                        <select @key="YearSelectorRenderKey"
                                data-testid="work-year-selector"
                                aria-label="السنة"
                                value="@SelectedWorkYear"
                                disabled="@(IsSaving || IsYearLoading)"
                                @onchange="ChangeWorkYearAsync">
                            @foreach (var year in AvailableWorkYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </label>

                    <button type="button"
                            id="work-orders-basket-details-trigger"
                            class="basket-details-trigger basket-header-trigger"
                            data-testid="work-orders-basket-details-trigger"
                            aria-controls="tabulator-test-table-basket-dashboard"
                            aria-expanded="true"
                            onclick="window.tabulatorTest.toggleBasketOverview('tabulator-test-table', this)">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <rect x="5" y="5" width="14" height="16" rx="2"></rect>
                            <path d="M9 5V3h6v2M8 10h8M8 14h8M8 18h5"></path>
                        </svg>
                        <span>تفاصيل السلال</span>
                        <b>@WorkOrderBuskets.All.Count</b>
                    </button>
                }
            </div>

            @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="actions-area">
                    <div class="action-row">
                        <div class="system-message" role="status" aria-live="polite">
                            <span class="message-dot" aria-hidden="true"></span>
                            <strong id="tabulator-test-table-status"
                                    data-testid="work-orders-status">
                                Preparing database rows...
                            </strong>
                        </div>

                        <div class="command-actions">
                            <details class="commands-wrap sheet-commands-menu">
                                <summary class="button button-secondary commands-button">
                                    <span class="keyboard-glyph" aria-hidden="true">⌨</span>
                                    <span>الأوامر</span>
                                </summary>

                                <div class="commands-menu" role="menu">
                                    <div class="commands-menu-title">
                                        <strong>أوامر الشيت</strong>
                                        <span>يمكن الضغط على الأمر أو استخدام الاختصار.</span>
                                    </div>

                                    <button type="button"
                                            class="command-item"
                                            data-testid="work-orders-undo"
                                            disabled="@IsYearLoading"
                                            onclick="window.tabulatorTest.undo('tabulator-test-table')">
                                        <span>Undo</span><kbd>Ctrl+Z</kbd>
                                    </button>

                                    <button type="button"
                                            class="command-item"
                                            data-testid="work-orders-redo"
                                            disabled="@IsYearLoading"
                                            onclick="window.tabulatorTest.redo('tabulator-test-table')">
                                        <span>Redo</span><kbd>Ctrl+Y</kbd>
                                    </button>

                                    <button type="button"
                                            class="command-item"
                                            data-testid="work-orders-copy"
                                            disabled="@IsYearLoading"
                                            onclick="window.tabulatorTest.copyRange('tabulator-test-table')">
                                        <span>Copy</span><kbd>Ctrl+C</kbd>
                                    </button>

                                    <button type="button"
                                            class="command-item"
                                            data-testid="work-orders-insert"
                                            disabled="@IsYearLoading"
                                            onclick="window.tabulatorTest.openInsertDialog('tabulator-test-table')">
                                        <span>Insert Rows</span><kbd>—</kbd>
                                    </button>

                                    <button type="button"
                                            class="command-item"
                                            data-testid="work-orders-delete"
                                            disabled="@IsYearLoading"
                                            onclick="window.tabulatorTest.deleteSelectedRows('tabulator-test-table')">
                                        <span>Delete Rows</span><kbd>—</kbd>
                                    </button>

                                    <div class="commands-menu-note">
                                        Paste يظل عبر Ctrl+V حتى لا نضيف مسار Clipboard جديد.
                                    </div>
                                </div>
                            </details>

                            <button type="button"
                                    class="button button-primary save-button"
                                    data-testid="work-orders-save"
                                    disabled="@(IsSaving || IsYearLoading)"
                                    @onclick="SaveChangesAsync">
                                <svg aria-hidden="true" viewBox="0 0 24 24">
                                    <path d="M5 3h12l2 2v16H5zM8 3v6h8V3M8 21v-7h8v7"></path>
                                </svg>
                                <span>@(IsYearLoading ? "Loading..." : IsSaving ? "Saving..." : "Save")</span>
                                <b class="save-badge"
                                   id="tabulator-test-table-save-badge"
                                   hidden>0</b>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (IsLoading)
        {
            <div class="alert alert-info"
                 data-testid="work-orders-loading">
                Loading work orders from SQL Server...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger"
                 data-testid="work-orders-error">
                @ErrorMessage
            </div>
        }
        else
        {
            <section class="work-orders-open-summary kpi-grid"
                     id="tabulator-test-table-summary-overview"
                     data-testid="work-orders-summary"
                     data-aggregate-ready="false"
                     aria-label="ملخص أوامر العمل"
                     aria-live="polite">
                <article class="kpi-card kpi-card-one"
                         data-testid="work-orders-summary-count">
                    <div class="metric-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="5" y="5" width="14" height="16" rx="2"></rect>
                            <path d="M9 5V3h6v2M8 10h8M8 14h8M8 18h5"></path>
                        </svg>
                    </div>
                    <div>
                        <span>Open Work Orders</span>
                        <strong>Calculating...</strong>
                        <i></i>
                    </div>
                </article>
            </section>

            <section class="work-orders-basket-dashboard"
                     id="tabulator-test-table-basket-dashboard"
                     data-testid="work-orders-basket-dashboard"
                     data-dashboard-ready="false"
                     aria-label="Basket overview"
                     aria-live="polite">
                <div class="work-orders-basket-dashboard-loading">
                    Calculating Basket totals...
                </div>
            </section>

            <div class="work-order-toolbar-row">
                <div class="validation-navigator-slot">
                    <div class="validation-navigator"
                         id="tabulator-test-table-validation-panel"
                         data-testid="work-orders-validation"
                         role="status"
                         aria-live="polite"
                         hidden>
                        <div class="validation-navigator-summary">
                            <svg class="validation-navigator-icon"
                                 aria-hidden="true"
                                 viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7.5v6" />
                                <path d="M12 17h.01" />
                            </svg>

                            <div class="validation-navigator-copy">
                                <strong id="tabulator-test-table-validation-title">
                                    توجد أخطاء تمنع الحفظ
                                </strong>

                                <span class="validation-copy-divider" aria-hidden="true">|</span>

                                <span id="tabulator-test-table-validation-message"></span>
                            </div>
                        </div>

                        <div class="validation-navigator-actions">
                            <button type="button"
                                    class="validation-navigator-button"
                                    id="tabulator-test-table-validation-previous"
                                    onclick="window.tabulatorTest.previousValidationError('tabulator-test-table')">
                                السابق
                            </button>

                            <button type="button"
                                    class="validation-navigator-button"
                                    id="tabulator-test-table-validation-next"
                                    onclick="window.tabulatorTest.nextValidationError('tabulator-test-table')">
                                التالي
                            </button>
                        </div>
                    </div>
                </div>

                <div class="work-order-search-box" role="search" aria-label="بحث أمر العمل">
                    <label class="work-order-search-label"
                           for="tabulator-work-order-search">
                        بحث أمر العمل
                    </label>

                    <input @key="SelectedWorkYear"
                           id="tabulator-work-order-search"
                           class="work-order-search-input"
                           data-testid="work-orders-search"
                           type="search"
                           inputmode="numeric"
                           autocomplete="off"
                           disabled="@IsYearLoading"
                           placeholder="ابحث برقم أمر العمل..."
                           oninput="window.tabulatorTest.filterByWorkOrder('tabulator-test-table', this.value)" />
                </div>
            </div>
        }
    </div>

    @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="work-orders-grid-shell"
             id="tabulator-test-table-shell"
             data-testid="work-orders-grid-shell">
            <div class="tabulator-card">
                <div id="tabulator-test-table"
                     data-testid="work-orders-grid"></div>
            </div>

            <div class="work-orders-selection-summary-host"
                 id="tabulator-test-table-summary-host"
                 data-testid="work-orders-selection-summary-host">
                <div class="work-orders-selection-summary work-orders-selection-summary-bar"
                     id="tabulator-test-table-summary-selection"
                     data-testid="work-orders-selection-summary"
                     data-aggregate-ready="false"
                     aria-live="polite"
                     hidden>
                </div>
            </div>
        </div>
    }

</div>
