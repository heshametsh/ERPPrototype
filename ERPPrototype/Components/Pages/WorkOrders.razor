@page "/work-orders"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable

@using System.Diagnostics
@using System.Globalization
@using System.Text.Json
@using ERPPrototype.Data
@using ERPPrototype.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = AppRoles.Employee)]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject WorkOrderService WorkOrderService
@inject IJSRuntime JSRuntime
@inject ILogger<WorkOrders> Logger

<PageTitle>Work Orders</PageTitle>

<div class="work-orders-page tabulator-workorders-page"
     data-testid="work-orders-page">

    <div class="work-orders-sticky-controls">
        <div class="page-header-row">
            <div class="page-title-block">
                <h1 data-testid="work-orders-title">Work Orders</h1>

                <div class="page-context-row">
                    <div class="page-subtitle"
                         data-testid="work-orders-scope">
                        @if (IsLoading)
                        {
                            <span>Loading department data...</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(DepartmentName))
                        {
                            <span>@BranchName — @DepartmentName</span>
                        }
                        else
                        {
                            <span>Work Orders</span>
                        }
                    </div>

                    @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <label class="work-year-selector">
                            <span>Year</span>

                            <select @key="YearSelectorRenderKey"
                                    class="work-year-select"
                                    data-testid="work-year-selector"
                                    value="@SelectedWorkYear"
                                    disabled="@(IsSaving || IsYearLoading)"
                                    @onchange="ChangeWorkYearAsync">
                                @foreach (var year in AvailableWorkYears)
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </label>
                    }
                </div>
            </div>

            @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="page-actions-box">
                    <div class="page-actions-buttons">
                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                data-testid="work-orders-undo"
                                disabled="@IsYearLoading"
                                onclick="window.tabulatorTest.undo('tabulator-test-table')">
                            Undo
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                data-testid="work-orders-redo"
                                disabled="@IsYearLoading"
                                onclick="window.tabulatorTest.redo('tabulator-test-table')">
                            Redo
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                data-testid="work-orders-insert"
                                disabled="@IsYearLoading"
                                onclick="window.tabulatorTest.openInsertDialog('tabulator-test-table')">
                            Insert Rows
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                data-testid="work-orders-delete"
                                disabled="@IsYearLoading"
                                onclick="window.tabulatorTest.deleteSelectedRows('tabulator-test-table')">
                            Delete Rows
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-primary"
                                data-testid="work-orders-copy"
                                disabled="@IsYearLoading"
                                onclick="window.tabulatorTest.copyRange('tabulator-test-table')">
                            Copy Selected Cells
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-primary"
                                data-testid="work-orders-save"
                                disabled="@(IsSaving || IsYearLoading)"
                                @onclick="SaveChangesAsync">
                            @(IsYearLoading ? "Loading..." : IsSaving ? "Saving..." : "Save")
                        </button>
                    </div>

                    <div class="save-status"
                         id="tabulator-test-table-status"
                         data-testid="work-orders-status">
                        Preparing database rows...
                    </div>
                </div>
            }
        </div>

        @if (IsLoading)
        {
            <div class="alert alert-info"
                 data-testid="work-orders-loading">
                Loading work orders from SQL Server...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger"
                 data-testid="work-orders-error">
                @ErrorMessage
            </div>
        }
        else
        {
            <div class="work-orders-open-summary"
                 id="tabulator-test-table-summary-overview"
                 data-testid="work-orders-summary"
                 data-aggregate-ready="false"
                 aria-live="polite">
                <div class="work-orders-summary-item"
                     data-testid="work-orders-summary-count">
                    <span class="work-orders-summary-label">
                        Open Work Orders
                    </span>
                    <strong class="work-orders-summary-value">
                        Calculating...
                    </strong>
                </div>
            </div>

            <div class="work-order-toolbar-row">
                <div class="validation-navigator-slot">
                    <div class="validation-navigator"
                         id="tabulator-test-table-validation-panel"
                         data-testid="work-orders-validation"
                         role="status"
                         aria-live="polite"
                         hidden>
                        <div class="validation-navigator-summary">
                            <span class="validation-navigator-icon"
                                  aria-hidden="true">!</span>

                            <div class="validation-navigator-copy">
                                <strong id="tabulator-test-table-validation-title">
                                    توجد أخطاء تمنع الحفظ
                                </strong>

                                <span id="tabulator-test-table-validation-message">
                                </span>
                            </div>
                        </div>

                        <div class="validation-navigator-actions">
                            <button type="button"
                                    class="validation-navigator-button"
                                    id="tabulator-test-table-validation-previous"
                                    onclick="window.tabulatorTest.previousValidationError('tabulator-test-table')">
                                السابق
                            </button>

                            <button type="button"
                                    class="validation-navigator-button"
                                    id="tabulator-test-table-validation-next"
                                    onclick="window.tabulatorTest.nextValidationError('tabulator-test-table')">
                                التالي
                            </button>
                        </div>
                    </div>
                </div>

                <div class="work-order-search-box">
                    <label class="work-order-search-label"
                           for="tabulator-work-order-search">
                        بحث أمر العمل
                    </label>

                    <input @key="SelectedWorkYear"
                           id="tabulator-work-order-search"
                           class="work-order-search-input"
                           data-testid="work-orders-search"
                           type="search"
                           inputmode="numeric"
                           autocomplete="off"
                           disabled="@IsYearLoading"
                           placeholder="اكتب رقم أمر العمل..."
                           oninput="window.tabulatorTest.filterByWorkOrder('tabulator-test-table', this.value)" />
                </div>
            </div>
        }
    </div>

    @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="tabulator-card">
            <div id="tabulator-test-table"
                 data-testid="work-orders-grid"></div>
        </div>

        <div class="work-orders-selection-summary work-orders-selection-summary-bar"
             id="tabulator-test-table-summary-selection"
             data-testid="work-orders-selection-summary"
             data-aggregate-ready="false"
             aria-live="polite"
             hidden>
        </div>
    }

</div>
