@page "/work-orders"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Globalization
@using ERPPrototype.Data
@using ERPPrototype.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = AppRoles.Employee)]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject WorkOrderService WorkOrderService
@inject IJSRuntime JSRuntime
@inject ILogger<WorkOrders> Logger

<PageTitle>Work Orders</PageTitle>

<div class="work-orders-page">
    <div class="work-orders-header">
        <div>
            <h1>Work Orders</h1>

            <div class="work-orders-context">
                @if (IsLoading)
                {
                    <span>Loading department data...</span>
                }
                else if (!string.IsNullOrWhiteSpace(DepartmentName))
                {
                    <span>@BranchName — @DepartmentName</span>
                }
                else
                {
                    <span>Work Orders</span>
                }

                @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <label class="work-year-selector">
                        <span>Year</span>
                        <select class="work-year-select"
                                value="@SelectedWorkYear"
                                disabled="@(IsSaving || IsYearLoading)"
                                @onchange="ChangeWorkYearAsync">
                            @foreach (var year in AvailableWorkYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </label>
                }
            </div>
        </div>

        @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="work-orders-actions">
                <button type="button"
                        class="save-button"
                        disabled="@(IsSaving || IsYearLoading)"
                        @onclick="SaveChangesAsync">
                    @(IsSaving ? "Saving..." : IsYearLoading ? "Loading..." : "Save")
                </button>

                <div id="work-orders-table-status"
                     class="save-status"
                     role="status"
                     aria-live="polite">
                    Preparing rows...
                </div>
            </div>
        }
    </div>

    @if (IsLoading)
    {
        <div class="alert alert-info">Loading work orders from SQL Server...</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else
    {
        <div class="phase-note">
            Performance baseline: display, direct cell editing, year switching, and delta save only.
        </div>

        <div class="tabulator-card">
            <div id="work-orders-table"></div>
        </div>
    }
</div>

@code {
    private const string TableId = "work-orders-table";

    private bool IsLoading = true;
    private bool IsSaving;
    private bool IsYearLoading;
    private bool GridInitialized;

    private int SelectedWorkYear = DateTime.Now.Year;

    private string CurrentUserId = string.Empty;
    private string BranchName = string.Empty;
    private string DepartmentName = string.Empty;
    private string ErrorMessage = string.Empty;

    private List<int> AvailableWorkYears = [DateTime.Now.Year];
    private List<TabulatorWorkOrderRow> Rows = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var userId = UserManager.GetUserId(authenticationState.User);

            if (string.IsNullOrWhiteSpace(userId))
            {
                ErrorMessage = "The current user could not be identified.";
                return;
            }

            CurrentUserId = userId;

            var sheet = await WorkOrderService.LoadSheetAsync(
                CurrentUserId,
                SelectedWorkYear);

            if (sheet is null)
            {
                ErrorMessage =
                    "The current user is not assigned to an active department.";
                return;
            }

            ApplySheet(sheet);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An error occurred while loading work orders.");

            ErrorMessage =
                "An unexpected error occurred while loading work orders.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (
            GridInitialized ||
            IsLoading ||
            IsYearLoading ||
            !string.IsNullOrWhiteSpace(ErrorMessage))
        {
            return;
        }

        GridInitialized = true;

        try
        {
            var stopwatch = System.Diagnostics.Stopwatch.StartNew();

            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.initialize",
                TableId,
                Rows);

            stopwatch.Stop();

            Logger.LogInformation(
                "Transferred and initialized {WorkOrderCount} minimal Tabulator rows in {ElapsedMilliseconds} ms.",
                Rows.Count,
                stopwatch.ElapsedMilliseconds);
        }
        catch (Exception exception)
        {
            GridInitialized = false;

            Logger.LogError(
                exception,
                "An error occurred while initializing the minimal Tabulator grid.");

            ErrorMessage = "The work-order sheet could not be initialized.";
            StateHasChanged();
        }
    }

    private async Task SaveChangesAsync()
    {
        if (
            IsSaving ||
            IsYearLoading ||
            string.IsNullOrWhiteSpace(CurrentUserId))
        {
            return;
        }

        IsSaving = true;

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.setSaving",
                TableId,
                true);

            var dirtyRows =
                await JSRuntime.InvokeAsync<List<TabulatorWorkOrderRow>>(
                    "tabulatorTest.getDirtyRows",
                    TableId);

            if (dirtyRows.Count == 0)
            {
                await SetGridStatusAsync("لا توجد تغييرات للحفظ.");
                return;
            }

            var changedWorkOrders = new List<WorkOrder>();

            foreach (var row in dirtyRows)
            {
                if (!TryParseAssignmentDate(
                        row.AssignmentDate,
                        out var assignmentDate))
                {
                    await SetGridStatusAsync(
                        $"تعذر الحفظ: تاريخ الإسناد غير صحيح في أمر العمل {row.WorkOrderNumber}.");
                    return;
                }

                changedWorkOrders.Add(
                    new WorkOrder
                    {
                        Id = row.Id,
                        RowVersion = DecodeRowVersion(row.RowVersion),
                        WorkYear = assignmentDate?.Year ?? SelectedWorkYear,
                        DisplayOrder = row.DisplayOrder,
                        WorkOrderNumber = row.WorkOrderNumber ?? string.Empty,
                        WorkTypeCode = row.WorkTypeCode ?? string.Empty,
                        AssignmentDate = assignmentDate,
                        Busket = row.Basket ?? string.Empty,
                        Status = row.Status ?? string.Empty,
                        Notes = row.Notes
                    });
            }

            await SetGridStatusAsync("جارٍ حفظ التغييرات...");

            var result = await WorkOrderService.SaveChangesAsync(
                CurrentUserId,
                SelectedWorkYear,
                [],
                changedWorkOrders,
                []);

            if (!result.Succeeded)
            {
                await SetGridStatusAsync(CreateFailureMessage(result));
                return;
            }

            var savedRecords = result.SavedRecords ?? [];

            var savedRows = savedRecords
                .Where(record => record.WorkYear == SelectedWorkYear)
                .Select(MapSavedRow)
                .ToList();

            var movedRowIds = savedRecords
                .Where(record => record.WorkYear != SelectedWorkYear)
                .Select(record => record.Id)
                .ToList();

            MergeRowsAfterSave(savedRows, movedRowIds);

            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.applySavedRows",
                TableId,
                savedRows,
                movedRowIds);

            var message = movedRowIds.Count > 0
                ? $"تم حفظ {savedRecords.Count} صف، ونقل {movedRowIds.Count} صف إلى سنة تاريخ الإسناد."
                : $"تم حفظ {savedRecords.Count} صف بنجاح.";

            await SetGridStatusAsync(message);
        }
        catch (JSDisconnectedException)
        {
            Logger.LogWarning(
                "The browser disconnected while saving work orders.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An unexpected error occurred while saving work orders.");

            try
            {
                await SetGridStatusAsync(
                    "حدث خطأ غير متوقع أثناء الحفظ.");
            }
            catch (JSDisconnectedException)
            {
            }
        }
        finally
        {
            IsSaving = false;

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "tabulatorTest.setSaving",
                    TableId,
                    false);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task ChangeWorkYearAsync(ChangeEventArgs args)
    {
        if (
            IsSaving ||
            IsYearLoading ||
            string.IsNullOrWhiteSpace(CurrentUserId) ||
            !int.TryParse(
                args.Value?.ToString(),
                NumberStyles.None,
                CultureInfo.InvariantCulture,
                out var requestedYear) ||
            requestedYear == SelectedWorkYear)
        {
            return;
        }

        if (GridInitialized)
        {
            var hasUnsavedChanges =
                await JSRuntime.InvokeAsync<bool>(
                    "tabulatorTest.hasUnsavedChanges",
                    TableId);

            if (hasUnsavedChanges)
            {
                await SetGridStatusAsync(
                    "احفظ التغييرات الحالية قبل الانتقال إلى سنة أخرى.");

                StateHasChanged();
                return;
            }
        }

        await LoadWorkYearAsync(requestedYear);
    }

    private async Task LoadWorkYearAsync(int workYear)
    {
        IsYearLoading = true;
        StateHasChanged();

        try
        {
            var sheet = await WorkOrderService.LoadSheetAsync(
                CurrentUserId,
                workYear);

            if (sheet is null)
            {
                await SetGridStatusAsync(
                    "تعذر تحميل سنة العمل المطلوبة.");
                return;
            }

            if (GridInitialized)
            {
                await JSRuntime.InvokeVoidAsync(
                    "tabulatorTest.destroy",
                    TableId);

                GridInitialized = false;
            }

            ApplySheet(sheet);
        }
        catch (JSDisconnectedException)
        {
            Logger.LogWarning(
                "The browser disconnected while changing the work-order year.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An error occurred while loading work-order year {WorkYear}.",
                workYear);

            await SetGridStatusAsync(
                "حدث خطأ أثناء تحميل سنة العمل المطلوبة.");
        }
        finally
        {
            IsYearLoading = false;
            StateHasChanged();
        }
    }

    private void ApplySheet(WorkOrderSheetData sheet)
    {
        BranchName = sheet.BranchName;
        DepartmentName = sheet.DepartmentName;
        SelectedWorkYear = sheet.WorkYear;
        AvailableWorkYears = sheet.AvailableYears;
        Rows = MapRows(sheet.WorkOrders, sheet.WorkYear);
    }

    private async Task SetGridStatusAsync(string message)
    {
        if (!GridInitialized)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "tabulatorTest.setStatus",
            TableId,
            message);
    }

    private void MergeRowsAfterSave(
        IEnumerable<TabulatorWorkOrderRow> savedRows,
        IReadOnlyCollection<int> movedRowIds)
    {
        var movedIds = movedRowIds.ToHashSet();

        var mergedRows = Rows
            .Where(row => !movedIds.Contains(row.Id))
            .ToDictionary(row => row.Id);

        foreach (var savedRow in savedRows)
        {
            mergedRows[savedRow.Id] = savedRow;
        }

        Rows = mergedRows.Values
            .OrderBy(row => row.DisplayOrder)
            .ThenBy(row => row.Id)
            .ToList();
    }

    private static string CreateFailureMessage(WorkOrderSaveResult result)
    {
        return result.FailureType switch
        {
            WorkOrderSaveFailureType.Duplicate =>
                "تعذر الحفظ: رقم أمر العمل مع نوع العمل مسجل بالفعل.",

            WorkOrderSaveFailureType.Concurrency =>
                "تعذر الحفظ: تم تعديل هذا الصف من جلسة أخرى. حدّث الصفحة ثم أعد التعديل.",

            WorkOrderSaveFailureType.Scope =>
                "تعذر الحفظ: هذا الصف خارج نطاق القسم المسموح للمستخدم.",

            WorkOrderSaveFailureType.Validation =>
                $"تعذر الحفظ: {result.ErrorMessage}",

            _ => "تعذر حفظ التغييرات بسبب خطأ في قاعدة البيانات."
        };
    }

    private static TabulatorWorkOrderRow MapSavedRow(
        WorkOrderSavedRecord record) =>
        new()
        {
            Id = record.Id,
            WorkYear = record.WorkYear,
            DisplayOrder = record.DisplayOrder,
            WorkOrderNumber = record.WorkOrderNumber,
            WorkTypeCode = record.WorkTypeCode,
            AssignmentDate = record.AssignmentDate?.ToString(
                "dd/MM/yyyy",
                CultureInfo.InvariantCulture) ?? string.Empty,
            Basket = record.Busket,
            Status = record.Status,
            Notes = record.Notes ?? string.Empty,
            RowVersion = Convert.ToBase64String(record.RowVersion)
        };

    private static List<TabulatorWorkOrderRow> MapRows(
        IEnumerable<WorkOrderSheetRow> workOrders,
        int workYear)
    {
        return workOrders
            .Select(workOrder =>
                new TabulatorWorkOrderRow
                {
                    Id = workOrder.Id,
                    WorkYear = workYear,
                    DisplayOrder = workOrder.DisplayOrder,
                    WorkOrderNumber = workOrder.WorkOrderNumber,
                    WorkTypeCode = workOrder.WorkTypeCode,
                    AssignmentDate = workOrder.AssignmentDate?.ToString(
                        "dd/MM/yyyy",
                        CultureInfo.InvariantCulture) ?? string.Empty,
                    Basket = workOrder.Busket,
                    Status = workOrder.Status,
                    Notes = workOrder.Notes ?? string.Empty,
                    RowVersion = Convert.ToBase64String(
                        workOrder.RowVersion)
                })
            .ToList();
    }

    private static bool TryParseAssignmentDate(
        string? value,
        out DateTime? assignmentDate)
    {
        assignmentDate = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (!DateTime.TryParseExact(
                value.Trim(),
                "dd/MM/yyyy",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var parsedDate))
        {
            return false;
        }

        assignmentDate = parsedDate.Date;
        return true;
    }

    private static byte[] DecodeRowVersion(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        try
        {
            return Convert.FromBase64String(value);
        }
        catch (FormatException)
        {
            return [];
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!GridInitialized)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.destroy",
                TableId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        GridInitialized = false;
    }

    private sealed class TabulatorWorkOrderRow
    {
        public int Id { get; set; }
        public int WorkYear { get; set; }
        public long DisplayOrder { get; set; }
        public string WorkOrderNumber { get; set; } = string.Empty;
        public string WorkTypeCode { get; set; } = string.Empty;
        public string AssignmentDate { get; set; } = string.Empty;
        public string Basket { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public string RowVersion { get; set; } = string.Empty;
    }
}
