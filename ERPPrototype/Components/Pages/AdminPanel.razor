@page "/admin"
@rendermode InteractiveServer

@using ERPPrototype.Components.Admin
@using ERPPrototype.Data
@using ERPPrototype.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@attribute [Authorize(Roles = AppRoles.Admin)]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AdminAuthorizationService AdminAuthorizationService
@inject AdminBranchService AdminBranchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

<PageTitle>لوحة الإدارة</PageTitle>

<div class="container py-4" dir="rtl">
    <h1 class="mb-4">لوحة الإدارة</h1>

    <div class="border rounded-3 p-4 bg-white shadow-sm">
        <h2 class="mb-4">إدارة الفروع</h2>

        <div class="row g-3 align-items-end mb-4">
            <div class="col-lg-8">
                <label class="form-label">اسم الفرع</label>

                <input class="form-control"
                       placeholder="مثال: فرع الأحساء"
                       @bind="NewBranchName" />
            </div>

            <div class="col-lg-auto">
                <button type="button"
                        class="btn btn-primary px-4"
                        disabled="@IsSaving"
                        @onclick="AddBranchAsync">

                    @(IsSaving ? "جارٍ الحفظ..." : "إضافة فرع")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert @MessageCssClass mb-4">
                @Message
            </div>
        }

        @if (Branches.Count == 0)
        {
            <div class="border rounded-3 p-4 text-center">
                لا توجد فروع مسجلة حاليًا.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>اسم الفرع</th>
                            <th style="width: 330px;">الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var branch in Branches)
                        {
                            <tr>
                                <td>
                                    @if (EditingBranchId == branch.Id)
                                    {
                                        <input class="form-control"
                                               @bind="EditingBranchName" />
                                    }
                                    else
                                    {
                                        @branch.Name
                                    }
                                </td>

                                <td>
                                    @if (EditingBranchId == branch.Id)
                                    {
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    disabled="@IsSaving"
                                                    @onclick="SaveBranchEditAsync">
                                                حفظ
                                            </button>

                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    disabled="@IsSaving"
                                                    @onclick="CancelBranchEdit">
                                                إلغاء
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm"
                                                    disabled="@(EditingBranchId is not null || IsSaving)"
                                                    @onclick="() => StartBranchEdit(branch)">
                                                تعديل الاسم
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-success btn-sm"
                                                    disabled="@(EditingBranchId is not null || IsSaving)"
                                                    @onclick="() => OpenUserForm(branch)">
                                                إضافة مستخدم
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-dark btn-sm"
                                                    disabled="@(EditingBranchId is not null || IsSaving)"
                                                    @onclick="() => OpenUsersList(branch)">
                                                عرض المستخدمين
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (SelectedBranchForUser is not null)
        {
            <BranchUserForm BranchId="@SelectedBranchForUser.Id"
                            BranchName="@SelectedBranchForUser.Name"
                            OnCancelled="CloseUserForm"
                            OnUserCreated="HandleUserCreated" />
        }
        @if (SelectedBranchForUsersList is not null)
        {
            <BranchUsersList BranchId="@SelectedBranchForUsersList.Id"
                             BranchName="@SelectedBranchForUsersList.Name"
                             OnClosed="CloseUsersList" />
        }
    </div>
</div>

@code {
    private List<Branch> Branches { get; set; } = [];

    private string NewBranchName { get; set; } = string.Empty;

    private int? EditingBranchId { get; set; }

    private string EditingBranchName { get; set; } = string.Empty;

    private Branch? SelectedBranchForUser { get; set; }

    private Branch? SelectedBranchForUsersList { get; set; }

    private string Message { get; set; } = string.Empty;

    private string MessageCssClass { get; set; } = "alert-info";

    private bool IsSaving { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAdminAuthorizedAsync())
        {
            return;
        }

        await LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        await using var dbContext =
            await DbFactory.CreateDbContextAsync();

        Branches = await dbContext.Branches
            .AsNoTracking()
            .OrderBy(branch => branch.Name)
            .ToListAsync();
    }

    private async Task AddBranchAsync()
    {
        Message = string.Empty;
        IsSaving = true;

        try
        {
            var actorUserId = await GetCurrentActorUserIdAsync();
            var result = await AdminBranchService.AddBranchAsync(
                actorUserId,
                NewBranchName);

            if (!result.Succeeded)
            {
                ShowError(result.ErrorMessage);
                return;
            }

            NewBranchName = string.Empty;
            await LoadBranchesAsync();
            ShowSuccess(
                "تمت إضافة الفرع وإنشاء أقسامه الأساسية بنجاح.");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void StartBranchEdit(Branch branch)
    {
        Message = string.Empty;

        SelectedBranchForUser = null;
        SelectedBranchForUsersList = null;

        EditingBranchId = branch.Id;
        EditingBranchName = branch.Name;
    }

    private void CancelBranchEdit()
    {
        EditingBranchId = null;
        EditingBranchName = string.Empty;
    }

    private async Task SaveBranchEditAsync()
    {
        Message = string.Empty;

        if (EditingBranchId is null)
        {
            return;
        }

        IsSaving = true;

        try
        {
            var actorUserId = await GetCurrentActorUserIdAsync();
            var result = await AdminBranchService.RenameBranchAsync(
                actorUserId,
                EditingBranchId.Value,
                EditingBranchName);

            if (!result.Succeeded)
            {
                ShowError(result.ErrorMessage);
                return;
            }

            CancelBranchEdit();
            await LoadBranchesAsync();
            ShowSuccess("تم تعديل اسم الفرع بنجاح.");
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void OpenUserForm(Branch branch)
    {
        Message = string.Empty;

        CancelBranchEdit();

        SelectedBranchForUsersList = null;
        SelectedBranchForUser = branch;
    }

    private void CloseUserForm()
    {
        SelectedBranchForUser = null;
    }

    private void OpenUsersList(Branch branch)
    {
        Message = string.Empty;

        CancelBranchEdit();

        SelectedBranchForUser = null;
        SelectedBranchForUsersList = branch;
    }

    private void CloseUsersList()
    {
        SelectedBranchForUsersList = null;
    }

    private void HandleUserCreated()
    {
        Message = string.Empty;
    }

    private async Task<string?> GetCurrentActorUserIdAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        return UserManager.GetUserId(authenticationState.User);
    }

    private async Task<bool> EnsureAdminAuthorizedAsync()
    {
        var actorUserId = await GetCurrentActorUserIdAsync();
        var authorization = await AdminAuthorizationService.AuthorizeAsync(
            actorUserId);

        if (authorization.Succeeded)
        {
            return true;
        }

        var target = authorization.Failure ==
            AdminAuthorizationFailure.MustChangePassword
                ? "/Account/Manage/ChangePassword"
                : "/Account/AccessDenied";

        NavigationManager.NavigateTo(target, forceLoad: true);
        return false;
    }
    private void ShowSuccess(string message)
    {
        Message = message;
        MessageCssClass = "alert-success";
    }

    private void ShowError(string message)
    {
        Message = message;
        MessageCssClass = "alert-danger";
    }
}