@page "/tabulator-test"
@rendermode InteractiveServer

@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<PageTitle>Tabulator Test</PageTitle>

<div class="container-fluid p-3">

    <h1 class="mb-3">Tabulator Performance Test</h1>

    <div class="alert alert-info">
        اختبار سرعة التمرير والتحرير والنسخ واللصق باستخدام 10,000 صف.
    </div>

    <div class="d-flex gap-2 mb-2">

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                onclick="window.tabulatorTest.undo('tabulator-test-table')">
            Undo
        </button>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                onclick="window.tabulatorTest.redo('tabulator-test-table')">
            Redo
        </button>

        <button type="button"
                class="btn btn-outline-primary btn-sm"
                onclick="window.tabulatorTest.copyRange('tabulator-test-table')">
            Copy Selected Cells
        </button>

    </div>

    <div class="mb-2 fw-semibold"
         id="tabulator-test-table-status">
        جاري تجهيز البيانات...
    </div>

    <div id="tabulator-test-table"></div>

</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "tabulatorTest.initialize",
            "tabulator-test-table",
            10000);
    }
}