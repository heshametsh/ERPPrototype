@page "/tabulator-test"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Globalization
@using ERPPrototype.Data
@using ERPPrototype.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@attribute [Authorize(Roles = AppRoles.Employee)]

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject WorkOrderService WorkOrderService
@inject IJSRuntime JSRuntime
@inject ILogger<TabulatorTest> Logger

<PageTitle>Work Orders</PageTitle>

<div class="work-orders-page tabulator-workorders-page">

    <div class="work-orders-sticky-controls">
        <div class="page-header-row">
            <div>
                <h1>Work Orders</h1>

                <div class="page-subtitle">
                    @if (IsLoading)
                    {
                        <span>Loading department data...</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(DepartmentName))
                    {
                        <span>@BranchName — @DepartmentName</span>
                    }
                    else
                    {
                        <span>Tabulator Prototype</span>
                    }
                </div>
            </div>

            @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="page-actions-box">
                    <div class="page-actions-buttons">
                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                onclick="window.tabulatorTest.undo('tabulator-test-table')">
                            Undo
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                onclick="window.tabulatorTest.redo('tabulator-test-table')">
                            Redo
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                onclick="window.tabulatorTest.openInsertDialog('tabulator-test-table')">
                            Insert Rows
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-secondary"
                                onclick="window.tabulatorTest.deleteSelectedRows('tabulator-test-table')">
                            Delete Rows
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-primary"
                                onclick="window.tabulatorTest.copyRange('tabulator-test-table')">
                            Copy Selected Cells
                        </button>

                        <button type="button"
                                class="page-action-button page-action-button-primary"
                                disabled="@IsSaving"
                                @onclick="SaveChangesAsync">
                            @(IsSaving ? "Saving..." : "Save")
                        </button>
                    </div>

                    <div class="save-status"
                         id="tabulator-test-table-status">
                        Preparing database rows...
                    </div>
                </div>
            }
        </div>

        @if (IsLoading)
        {
            <div class="alert alert-info">
                Loading work orders from SQL Server...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }
        else
        {
            <div class="grid-instructions">
                Select any cell, then use Insert Rows or right-click inside the sheet.
                Insert or delete rows where needed, then press Save to store the changes in SQL Server.
            </div>

            <div class="work-order-toolbar-row">
                <div class="validation-navigator-slot">
                    <div class="validation-navigator"
                         id="tabulator-test-table-validation-panel"
                         role="status"
                         aria-live="polite"
                         hidden>
                        <div class="validation-navigator-summary">
                            <span class="validation-navigator-icon"
                                  aria-hidden="true">!</span>

                            <div class="validation-navigator-copy">
                                <strong id="tabulator-test-table-validation-title">
                                    توجد أخطاء تمنع الحفظ
                                </strong>

                                <span id="tabulator-test-table-validation-message">
                                </span>
                            </div>
                        </div>

                        <div class="validation-navigator-actions">
                            <button type="button"
                                    class="validation-navigator-button"
                                    id="tabulator-test-table-validation-previous"
                                    onclick="window.tabulatorTest.previousValidationError('tabulator-test-table')">
                                السابق
                            </button>

                            <button type="button"
                                    class="validation-navigator-button"
                                    id="tabulator-test-table-validation-next"
                                    onclick="window.tabulatorTest.nextValidationError('tabulator-test-table')">
                                التالي
                            </button>
                        </div>
                    </div>
                </div>

                <div class="work-order-search-box">
                    <label class="work-order-search-label"
                           for="tabulator-work-order-search">
                        بحث أمر العمل
                    </label>

                    <input id="tabulator-work-order-search"
                           class="work-order-search-input"
                           type="search"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="اكتب رقم أمر العمل..."
                           oninput="window.tabulatorTest.filterByWorkOrder('tabulator-test-table', this.value)" />
                </div>
            </div>
        }
    </div>

    @if (!IsLoading && string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="tabulator-card">
            <div id="tabulator-test-table"></div>
        </div>
    }

</div>

@code {
    private const string TableId = "tabulator-test-table";

    private bool IsLoading = true;
    private bool IsSaving;
    private bool GridInitialized;

    private string CurrentUserId = string.Empty;
    private string BranchName = string.Empty;
    private string DepartmentName = string.Empty;
    private string ErrorMessage = string.Empty;

    private List<TabulatorWorkOrderRow> Rows = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var userId =
                UserManager.GetUserId(
                    authenticationState.User);

            if (string.IsNullOrWhiteSpace(userId))
            {
                ErrorMessage =
                    "The current user could not be identified.";

                return;
            }

            CurrentUserId = userId;

            var sheet =
                await WorkOrderService.LoadSheetAsync(userId);

            if (sheet is null)
            {
                ErrorMessage =
                    "The current user is not assigned to an active department.";

                return;
            }

            BranchName = sheet.BranchName;
            DepartmentName = sheet.DepartmentName;

            Rows = MapRows(sheet.WorkOrders);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An error occurred while loading Tabulator work orders.");

            ErrorMessage =
                "An unexpected error occurred while loading work orders.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (
            GridInitialized ||
            IsLoading ||
            !string.IsNullOrWhiteSpace(ErrorMessage))
        {
            return;
        }

        GridInitialized = true;

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.initialize",
                TableId,
                Rows,
                WorkOrderBuskets.All);
        }
        catch (Exception exception)
        {
            GridInitialized = false;

            Logger.LogError(
                exception,
                "An error occurred while initializing Tabulator.");

            ErrorMessage =
                "The work-order sheet could not be initialized.";

            StateHasChanged();
        }
    }

    private async Task SaveChangesAsync()
    {
        if (IsSaving || string.IsNullOrWhiteSpace(CurrentUserId))
        {
            return;
        }

        var canSave =
            await JSRuntime.InvokeAsync<bool>(
                "tabulatorTest.validateBeforeSave",
                TableId);

        if (!canSave)
        {
            return;
        }

        IsSaving = true;

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.setSaving",
                TableId,
                true);

            var dirtyRows =
                await JSRuntime.InvokeAsync<List<TabulatorWorkOrderRow>>(
                    "tabulatorTest.getDirtyRows",
                    TableId);

            var deletedRows =
                await JSRuntime.InvokeAsync<List<TabulatorDeletedRow>>(
                    "tabulatorTest.getDeletedRows",
                    TableId);

            if (dirtyRows.Count == 0 && deletedRows.Count == 0)
            {
                await SetGridStatusAsync(
                    "لا توجد تغييرات للحفظ.");

                return;
            }

            var blankAddedRow = dirtyRows
                .FirstOrDefault(row =>
                    row.Id <= 0 &&
                    IsCompletelyBlank(row));

            if (blankAddedRow is not null)
            {
                await SetGridStatusAsync(
                    "تعذر الحفظ: أكمل بيانات الصفوف الجديدة أو احذف الصفوف الفارغة أولًا.");

                return;
            }

            var addedWorkOrders =
                new List<WorkOrder>();

            var changedWorkOrders =
                new List<WorkOrder>();

            var addedRowMappings =
                new List<PendingAddedRowMapping>();

            foreach (var row in dirtyRows)
            {
                if (!TryParseAssignmentDate(
                        row.AssignmentDate,
                        out var assignmentDate))
                {
                    await SetGridStatusAsync(
                        $"تعذر الحفظ: تاريخ الإسناد غير صحيح في أمر العمل {row.WorkOrderNumber}.");

                    return;
                }

                var workOrder = new WorkOrder
                {
                    Id = row.Id,
                    DisplayOrder = row.DisplayOrder,
                    WorkOrderNumber = row.WorkOrderNumber ?? string.Empty,
                    WorkTypeCode = row.WorkTypeCode ?? string.Empty,
                    AssignmentDate = assignmentDate,
                    Busket = row.Basket ?? string.Empty,
                    Status = row.Status ?? string.Empty,
                    Notes = row.Notes
                };

                if (row.Id <= 0)
                {
                    addedWorkOrders.Add(workOrder);

                    addedRowMappings.Add(
                        new PendingAddedRowMapping
                        {
                            ClientKey = row.ClientKey,
                            TemporaryId = row.Id,
                            WorkOrder = workOrder
                        });
                }
                else
                {
                    changedWorkOrders.Add(workOrder);
                }
            }

            var deletedWorkOrders = deletedRows
                .Where(row => row.Id > 0)
                .Select(row => new WorkOrder
                {
                    Id = row.Id
                })
                .ToList();

            await SetGridStatusAsync(
                "جارٍ حفظ التغييرات...");

            var result =
                await WorkOrderService.SaveChangesAsync(
                    CurrentUserId,
                    addedWorkOrders,
                    changedWorkOrders,
                    deletedWorkOrders);

            if (!result.Succeeded)
            {
                if (
                    result.FailureType ==
                        WorkOrderSaveFailureType.Duplicate &&
                    !string.IsNullOrWhiteSpace(result.WorkOrderNumber) &&
                    !string.IsNullOrWhiteSpace(result.WorkTypeCode))
                {
                    var duplicateRows = dirtyRows
                        .Where(row =>
                            string.Equals(
                                row.WorkOrderNumber?.Trim(),
                                result.WorkOrderNumber,
                                StringComparison.Ordinal) &&
                            string.Equals(
                                row.WorkTypeCode?.Trim(),
                                result.WorkTypeCode,
                                StringComparison.Ordinal))
                        .ToList();

                    var duplicateMessage =
                        $"رقم أمر العمل {result.WorkOrderNumber} " +
                        $"مع النوع {result.WorkTypeCode} مسجل بالفعل.";

                    var validationErrors = duplicateRows
                        .SelectMany(row => new[]
                        {
                            new TabulatorValidationError
                            {
                                RowId = row.Id,
                                Field = "workOrderNumber",
                                Code = result.ErrorCode,
                                Message = duplicateMessage
                            },
                            new TabulatorValidationError
                            {
                                RowId = row.Id,
                                Field = "workTypeCode",
                                Code = result.ErrorCode,
                                Message = duplicateMessage
                            }
                        })
                        .ToList();

                    if (validationErrors.Count > 0)
                    {
                        await JSRuntime.InvokeVoidAsync(
                            "tabulatorTest.applyExternalValidationErrors",
                            TableId,
                            validationErrors,
                            true);
                    }
                }

                await SetGridStatusAsync(
                    $"فشل الحفظ: {result.ErrorMessage}");

                return;
            }

            var refreshedSheet =
                await WorkOrderService.LoadSheetAsync(
                    CurrentUserId);

            if (refreshedSheet is null)
            {
                await SetGridStatusAsync(
                    "تم الحفظ، لكن تعذر إعادة تحميل الشيت.");

                return;
            }

            Rows = MapRows(refreshedSheet.WorkOrders);

            var savedRowMappings = addedRowMappings
                .Select(mapping =>
                    new TabulatorSavedRowMapping
                    {
                        ClientKey = mapping.ClientKey,
                        TemporaryId = mapping.TemporaryId,
                        DatabaseId = mapping.WorkOrder.Id
                    })
                .ToList();

            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.replaceSavedData",
                TableId,
                Rows,
                savedRowMappings);

            var savedCount =
                dirtyRows.Count + deletedWorkOrders.Count;

            await SetGridStatusAsync(
                $"تم حفظ {savedCount} صف بنجاح.");
        }
        catch (JSDisconnectedException)
        {
            Logger.LogWarning(
                "The browser disconnected while saving Tabulator work orders.");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "An unexpected error occurred while saving Tabulator work orders.");

            try
            {
                await SetGridStatusAsync(
                    "حدث خطأ غير متوقع أثناء الحفظ.");
            }
            catch (JSDisconnectedException)
            {
            }
        }
        finally
        {
            IsSaving = false;

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "tabulatorTest.setSaving",
                    TableId,
                    false);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task SetGridStatusAsync(string message)
    {
        await JSRuntime.InvokeVoidAsync(
            "tabulatorTest.setStatus",
            TableId,
            message);
    }

    private static List<TabulatorWorkOrderRow> MapRows(
        IEnumerable<WorkOrder> workOrders)
    {
        return workOrders
            .Select(workOrder =>
                new TabulatorWorkOrderRow
                {
                    Id = workOrder.Id,
                    DisplayOrder = workOrder.DisplayOrder,
                    WorkOrderNumber = workOrder.WorkOrderNumber,
                    WorkTypeCode = workOrder.WorkTypeCode,
                    AssignmentDate =
                        workOrder.AssignmentDate?.ToString(
                            "dd/MM/yyyy",
                            CultureInfo.InvariantCulture)
                        ?? string.Empty,
                    Basket = workOrder.Busket,
                    Status = workOrder.Status,
                    Notes = workOrder.Notes ?? string.Empty
                })
            .ToList();
    }

    private static bool IsCompletelyBlank(
        TabulatorWorkOrderRow row)
    {
        return
            string.IsNullOrWhiteSpace(row.WorkOrderNumber) &&
            string.IsNullOrWhiteSpace(row.WorkTypeCode) &&
            string.IsNullOrWhiteSpace(row.AssignmentDate) &&
            string.IsNullOrWhiteSpace(row.Basket) &&
            string.IsNullOrWhiteSpace(row.Status) &&
            string.IsNullOrWhiteSpace(row.Notes);
    }

    private static bool TryParseAssignmentDate(
        string? value,
        out DateTime? assignmentDate)
    {
        assignmentDate = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (!DateTime.TryParseExact(
                value.Trim(),
                "dd/MM/yyyy",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var parsedDate))
        {
            return false;
        }

        assignmentDate = parsedDate.Date;
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!GridInitialized)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "tabulatorTest.destroy",
                TableId);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        GridInitialized = false;
    }

    private sealed class TabulatorDeletedRow
    {
        public int Id { get; set; }
    }

    private sealed class PendingAddedRowMapping
    {
        public string ClientKey { get; set; } = string.Empty;
        public int TemporaryId { get; set; }
        public WorkOrder WorkOrder { get; set; } = new();
    }

    private sealed class TabulatorSavedRowMapping
    {
        public string ClientKey { get; set; } = string.Empty;
        public int TemporaryId { get; set; }
        public int DatabaseId { get; set; }
    }

    private sealed class TabulatorValidationError
    {
        public int RowId { get; set; }
        public string Field { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }

    private sealed class TabulatorWorkOrderRow
    {
        public int Id { get; set; }
        public string ClientKey { get; set; } = string.Empty;
        public long DisplayOrder { get; set; }
        public string WorkOrderNumber { get; set; } = string.Empty;
        public string WorkTypeCode { get; set; } = string.Empty;
        public string AssignmentDate { get; set; } = string.Empty;
        public string Basket { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
    }
}
