@page "/work-orders-revogrid"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using ERPPrototype.Data
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = AppRoles.Employee)]

<PageTitle>RevoGrid Gate 5C-1</PageTitle>

<section id="revogrid-open-kpi"
         class="gate5c1-kpis"
         data-testid="open-kpi"
         data-aggregate-ready="false"
         aria-label="ملخص أوامر العمل المفتوحة"
         aria-live="polite">
</section>

@* Shown by the totals owner only while a Filter is active. *@
<section class="gate5c1-summary"
         data-visible-filter-summary
         hidden
         aria-label="إجماليات الصفوف الظاهرة">
    <div class="gate5c1-summary__title">
        إجمالي الظاهر بالفلتر
    </div>

    <div id="revogrid-gate5c1-visible-aggregates"
         class="gate5c1-summary__values"
         data-testid="gate5c1-visible-aggregates"
         data-aggregate-ready="false"
         aria-live="polite">
        جاري الحساب…
    </div>
</section>

<WorkOrdersRevoGridNativeGate5A EnableChangeEngine="true"
                                  EnablePaste="true"
                                  EnableRangeClear="true"
                                  EnableExcelFilter="true"
                                  EnableHeaderActions="true"
                                  EnableRowStructure="true"
                                  EnableUnifiedValidation="true"
                                  EnablePersistenceIdentity="true"
                                  EnableSelectionContext="true"
                                  EnableStructureWorkspace="true"
                                  EnableHeaderMultiSelection="true"
                                  EnableClipboardRangeFill="true"
                                  EnableSaveHandshake="true"
                                  EnableRealDbSave="true"
                                  EnableVisibleAggregates="true"
                                  EnableColumnVisibility="true"
                                  EnableColumnWidth="true" />
